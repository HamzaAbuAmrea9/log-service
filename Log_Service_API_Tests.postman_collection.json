                "value": "test-loadgen-key-123"
              }
            ],
            "url": "http://localhost:8080/logs?limit=1",
            "description": "Logs with X-API-Key header"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 401', function () { pm.expect(pm.response.code === 200 || pm.response.code === 401).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
