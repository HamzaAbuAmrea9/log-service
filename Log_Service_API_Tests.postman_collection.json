            }
          ]
        },
        {
          "name": "GET /logs - No auth header",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/logs?limit=1",
            "description": "Logs without auth (200 if AUTH_ENABLED=false)"
          },
          "event": [
